{
  "name": "ai-tutorial-hub",
  "version": "1.0.0",
  "description": "Agent Engineering Hub - 智能体工程学习枢纽",
  "type": "module",
  "scripts": {
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "docs:audit": "node scripts/check-doc-links.mjs",
    "docs:check-links": "node scripts/check-doc-links.mjs",
    "docs:check-routes": "node scripts/check-routes.mjs",
    "docs:check-frontmatter": "node scripts/check-frontmatter.mjs",
    "docs:check-stale": "node scripts/check-stale-changes.mjs",
    "docs:audit-lighthouse": "node scripts/audit-lighthouse.mjs",
    "test": "npm run docs:check-links && npm run docs:check-routes && npm run docs:check-frontmatter && npm run docs:check-stale",
    "test:all": "npm test && npm run docs:check-stale && npm run docs:build"
  },
  "keywords": [
    "AI",
    "OpenSpec",
    "Skills",
    "Harness",
    "tutorial",
    "documentation",
    "VitePress"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "chrome-launcher": "^1.2.1",
    "lighthouse": "^13.4.0",
    "puppeteer-core": "^25.1.0",
    "vitepress": "^1.6.4"
  }
}
